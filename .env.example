# Karyalaya — local environment.
# Copy to .env.local and fill in. Never commit .env.local.
#
# The portal boots with every value below empty: it runs in demo mode against
# the seeded Alcadent fixtures so you can walk the whole surface first. Each
# block below switches on one more real capability.

# --- Supabase (switches the portal from demo mode to the live database) ------
# From `supabase start`, or from your project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS, so it is used exclusively through withTenantScope()
# in src/lib/tenancy.ts. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (switches the agent runtime off its offline fallback) ---------
ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API ------------------------------------------------------
# App secret: used to verify X-Hub-Signature-256 on every inbound delivery.
WHATSAPP_APP_SECRET=
# Verify token: any string you also enter in Meta's webhook setup form.
WHATSAPP_VERIFY_TOKEN=
# Access token for the test number (development) or the client's number (pilot).
WHATSAPP_ACCESS_TOKEN=

# --- Encryption for per-tenant channel credentials ---------------------------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_SECRET_KEY=

# --- Scheduled agents --------------------------------------------------------
# Bearer token required by POST /api/cron/recalls.
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# Force demo mode even with Supabase configured (for a walkthrough).
# KARYALAYA_DEMO=1
